{
  "name": "looming-logger-react-native",
  "version": "1.0.0",
  "description": "Looming Tech React Native Logging SDK - Remote logging for React Native apps. Sends logs to a self-hosted Loki backend with automatic batching, offline persistence, and device info collection.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf lib",
    "prepare": "yarn clean && yarn build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "lint": "eslint src __tests__"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Looming-Tech/looming-logger-react-native.git"
  },
  "license": "UNLICENSED",
  "private": false,
  "peerDependencies": {
    "@react-native-async-storage/async-storage": ">=1.19.0",
    "react-native": ">=0.71.0",
    "react-native-device-info": ">=10.0.0"
  },
  "devDependencies": {
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.0.0",
    "jest": "^29.7.0",
    "react-native": "^0.76.0",
    "react-native-device-info": "^15.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.ts"
    ]
  },
  "keywords": [
    "react-native",
    "logging",
    "loki",
    "looming"
  ]
}
